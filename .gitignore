# KiCad (per-user / automatic files)
*.kicad_prl
*-backups/
.history/
fp-info-cache
*.lck
_autosave-*
\#auto_saved_files\#
# footprint exported from the board by hand (the real one is lib/Linetracer2.pretty/)
hardware/kicad/AE-TC78H653FTG.kicad_mod

# auto-router intermediates (scripts/route_pcb.py makes them again); standard and Lite boards
hardware/**/reports/*.dsn
hardware/**/reports/*.ses
hardware/**/reports/placement.pdf
hardware/**/reports/top.pdf
hardware/**/reports/bot.pdf
hardware/**/reports/drc_place.rpt

# datasheets are the makers' documents: keep links only (docs/datasheets/README.md)
docs/datasheets/*.pdf

# Python
__pycache__/
*.pyc

# misc
.tmp/
.DS_Store

# Bambu Studio CLI output
result.json
