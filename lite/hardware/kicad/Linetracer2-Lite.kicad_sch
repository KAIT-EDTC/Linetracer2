	)
	(text "Power: AA x3 (alkaline 4.5V recommended / NiMH 3.6V) -> VBAT (motors) ; VBAT -> D1 Schottky -> VSYS -> XIAO 5V pin. USB 5V can not back-feed the batteries. Never use 4 cells (the XIAO's 5V input clamps above about 6 V)."
		(exclude_from_sim no)
		(at 20.32 24.13 0)
